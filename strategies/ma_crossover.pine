//@version=5
strategy("MA Crossover Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Parameters
fast_ma_length = input(9, "Fast MA Length")
slow_ma_length = input(21, "Slow MA Length")
webhook_url = input("", "Webhook URL")
webhook_secret = input("", "Webhook Secret")

// Calculate moving averages
fast_ma = ta.sma(close, fast_ma_length)
slow_ma = ta.sma(close, slow_ma_length)

// Plot MAs
plot(fast_ma, color=color.blue, linewidth=2, title="Fast MA")
plot(slow_ma, color=color.red, linewidth=2, title="Slow MA")

// Signals
long_signal = ta.crossover(fast_ma, slow_ma)
short_signal = ta.crossunder(fast_ma, slow_ma)

// Entry conditions
if long_signal
    strategy.entry("Long", strategy.long)

if short_signal
    strategy.entry("Short", strategy.short)

// Webhook alerts
if long_signal
    alert(json.stringify(map.new()
        .put("signal", "LONG")
        .put("symbol", syminfo.tickerid)
        .put("price", str.tostring(close))
        .put("strategy", "MA Crossover")
        .put("fast_ma", str.tostring(fast_ma))
        .put("slow_ma", str.tostring(slow_ma))
        ), alert.freq_once_per_bar)

if short_signal
    alert(json.stringify(map.new()
        .put("signal", "SHORT")
        .put("symbol", syminfo.tickerid)
        .put("price", str.tostring(close))
        .put("strategy", "MA Crossover")
        .put("fast_ma", str.tostring(fast_ma))
        .put("slow_ma", str.tostring(slow_ma))
        ), alert.freq_once_per_bar)
